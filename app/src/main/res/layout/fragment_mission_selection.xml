<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".MissionSelectionFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="48dp"
        android:text="choose your mission"
        android:textColor="@color/text_dark"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btn_mission_kitchen"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/mission_button_bg"
        android:backgroundTint="@color/mission_blue"
        android:text="Misi: Dapur"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_mission_living_room"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/mission_button_bg"
        android:backgroundTint="@color/mission_purple"
        android:text="Misi: Ruang Tamu"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_mission_garden"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/mission_button_bg"
        android:backgroundTint="@color/mission_green"
        android:text="Misi: Taman Belakang"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>